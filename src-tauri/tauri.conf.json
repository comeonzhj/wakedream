{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WakeDream",
  "version": "0.1.0",
  "identifier": "com.wakedream.desktop",
  "build": {
    "frontendDist": "./web-dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "夜间会话整理客户端",
    "longDescription": "WakeDream 把本机与远端设备上各 Agent 的会话收拢到一处，夜里跑一次「做梦」萃取成 wiki 式记忆库，供未来的会话只读挂载。桌面端为 Tauri 壳 + Node 边车，浏览器内核只负责渲染本地服务。",
    "copyright": "WakeDream",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web": "web"
    },
    "externalBin": ["binaries/wakedream-server"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {}
}
